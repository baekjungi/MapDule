AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-your-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional real routes and place search (server-only keys)
KAKAO_REST_API_KEY=
ODSAY_API_KEY=

# Optional closed-app departure notifications
MAPDULE_VAPID_PUBLIC_KEY=
MAPDULE_VAPID_PRIVATE_KEY=
MAPDULE_VAPID_SUBJECT=mailto:admin@example.com
# Production requires persistent storage and an external scheduler.
MAPDULE_STORAGE_CONNECTION_STRING=
MAPDULE_PUSH_DISPATCH_KEY=
